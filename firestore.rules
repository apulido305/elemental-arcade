rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------------------------------------------------------------------------------------------
    // Helpers
    // ---------------------------------------------------------------------------------------------
    function signedIn() { return request.auth != null; }

    // Guests in VS Arena use Firebase Anonymous Auth. They are signed in, but they are not accounts.
    function isAnon() { return request.auth.token.firebase.sign_in_provider == 'anonymous'; }
    function isAccount() { return signedIn() && !isAnon(); }

    function playerDoc(uid) { return /databases/$(database)/documents/players/$(uid); }

    // Cleanup (vs.js sweep): a match is dead once it has ended (expired, done or abandoned) and was created more
    // than a day ago. Any signed-in account may delete a dead match and everything under it; children of a match
    // that no longer exists (left over from an earlier partial delete) may be deleted too.
    function deadMatch(m) { return m.status in ['expired', 'done', 'abandoned'] && request.time > m.createdAt + duration.value(1, 'd'); }
    function matchPath(code) { return /databases/$(database)/documents/matches/$(code); }
    function seatPath(code, uid) { return /databases/$(database)/documents/matches/$(code)/players/$(uid); }

    function isParticipant(code) { return signedIn() && exists(seatPath(code, request.auth.uid)); }

    function deadOrGone(code) { return !exists(matchPath(code)) || deadMatch(get(matchPath(code)).data); }

    function answerPath(code, uid, q) { return /databases/$(database)/documents/matches/$(code)/answers/$(uid + '_' + string(q)); }

    // Match clock (must match vs.js): question 0 appears 5 s after startAt, each question is 15 s plus a 2.5 s reveal.
    // qn is the round length (10, 15 or 20; a match without the field is 10), so ten questions end 180 s after startAt.
    // Devices are assumed NTP-synced within a couple of seconds.
    function qn(m) { return m.get('qn', 10); }
    function qOpensAt(m, q) { return m.startAt + duration.value(5000 + q * 17500, 'ms'); }
    function clockOver(m) { return request.time > m.startAt + duration.value(3000 + qn(m) * 17500, 'ms'); }

    function codeOk(code) { return code.matches('^[ABCDEFGHJKMNPQRSTUVWXYZ23456789]{6}$'); }

    // Profile icons are ids, never markup (index.html ICONS, WIN_ICONS, GOLD_IDS). The 16 free ones anyone may use.
    // The 34 pack icons and the 50 '{id}-gold' icons only after unlocking them from a pack (progress.unlocked).
    function freeIcons() { return ['atom', 'bolt', 'beaker', 'crystal', 'flame', 'droplet', 'magnet', 'moon', 'star', 'comet', 'rocket', 'flask',
                            'crown', 'shield', 'spark', 'wave']; }
    function packIcons() { return ['boba', 'camera', 'cat', 'dice', 'dog', 'donut', 'pizza', 'note', 'sneaker', 'headphones', 'soccer', 'hoop',
                            'cactus', 'shades', 'bulb', 'skateboard', 'boombox', 'controller', 'vinyl', 'guitar', 'fox', 'panda', 'plane',
                            'rainbow', 'joystick', 'trophy', 'robot', 'planet', 'axolotl', 'ufo', 'volcano', 'chest', 'dragon', 'dino',
                            'atom-gold', 'bolt-gold', 'beaker-gold', 'crystal-gold', 'flame-gold', 'droplet-gold', 'magnet-gold', 'moon-gold',
                            'star-gold', 'comet-gold', 'rocket-gold', 'flask-gold', 'crown-gold', 'shield-gold', 'spark-gold', 'wave-gold',
                            'boba-gold', 'camera-gold', 'cat-gold', 'dice-gold', 'dog-gold', 'donut-gold', 'pizza-gold', 'note-gold',
                            'sneaker-gold', 'headphones-gold', 'soccer-gold', 'hoop-gold', 'cactus-gold', 'shades-gold', 'bulb-gold',
                            'skateboard-gold', 'boombox-gold', 'controller-gold', 'vinyl-gold', 'guitar-gold', 'fox-gold', 'panda-gold',
                            'plane-gold', 'rainbow-gold', 'joystick-gold', 'trophy-gold', 'robot-gold', 'planet-gold', 'axolotl-gold',
                            'ufo-gold', 'volcano-gold', 'chest-gold', 'dragon-gold', 'dino-gold']; }
    // /players doc: free, or unlocked in this same doc's progress.
    function iconOk(d) {
      return !('icon' in d) || d.icon in freeIcons()
        || ('progress' in d && d.progress.get('unlocked', []) is list && d.icon in d.progress.get('unlocked', []));
    }
    // Match seat: free; an account's unlocked icon (read from their /players doc); a guest's pack icon (a guest's
    // unlocks live only on their device, so the rules cannot check them: any pack icon id is accepted).
    function seatIconOk(d, uid) {
      return !('icon' in d) || d.icon in freeIcons()
        || (isAnon() && d.icon in packIcons())
        || (!isAnon() && exists(playerDoc(uid)) && d.icon in get(playerDoc(uid)).data.get('progress', {}).get('unlocked', []));
    }

    // ---------------------------------------------------------------------------------------------
    // /players/{uid}: each signed-in student reads and writes only their own save.
    // Anonymous guests never read or write here (guests have no stored progress).
    // Progress may carry the VS record (vs) and the time it was last written (vsAt). icon is the profile icon id.
    // ---------------------------------------------------------------------------------------------
    match /players/{uid} {
      allow read: if isAccount() && request.auth.uid == uid;
      allow create, update: if isAccount() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['progress', 'nick', 'cls', 'icon', 'updated'])
        && iconOk(request.resource.data)
        && request.resource.data.progress.keys().hasOnly(['owned', 'miss', 'stars', 'xp', 'rounds', 'best', 'vs', 'vsAt',
             'packs', 'finishes', 'finishOn', 'unlocked', 'packLog'])
        // Packs (index.html "packs"): unlocked icons must be pack icon ids; finishes are maps; the shown finish
        // per card is one of the four finish ids. Packs and packLog are lists (contents are rolled client-side).
        && (!('unlocked' in request.resource.data.progress)
            || (request.resource.data.progress.unlocked is list && request.resource.data.progress.unlocked.hasOnly(packIcons())))
        && (!('packs' in request.resource.data.progress) || (request.resource.data.progress.packs is list && request.resource.data.progress.packs.size() <= 200))
        && (!('packLog' in request.resource.data.progress) || request.resource.data.progress.packLog is list)
        && (!('finishes' in request.resource.data.progress) || request.resource.data.progress.finishes is map)
        && (!('finishOn' in request.resource.data.progress)
            || (request.resource.data.progress.finishOn is map
                && request.resource.data.progress.finishOn.values().hasOnly(['foil', 'holo', 'night', 'ember'])))
        && (!('vs' in request.resource.data.progress)
            || (request.resource.data.progress.vs is map
                && request.resource.data.progress.vs.keys().hasOnly(['w', 'l', 'streak', 'best', 'played'])))
        && (!('vsAt' in request.resource.data.progress) || request.resource.data.progress.vsAt is number);
      allow delete: if false;
    }

    // ---------------------------------------------------------------------------------------------
    // /names/{nick}: nickname -> class code, so sign-in needs only nickname + PIN (cloud.js).
    // Anyone may read one name (sign-in happens before auth); nobody may list them. An account may claim
    // only its own nickname and class, as encoded in its made-up sign-in email. First claim wins, forever.
    // ---------------------------------------------------------------------------------------------
    match /names/{nick} {
      allow get: if true;
      allow create: if isAccount()
        && request.resource.data.keys().hasOnly(['cls', 'uid'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.cls is string
        && request.auth.token.email == request.resource.data.cls + '_' + nick + '@players.elemental-arcade.example';
      allow update, delete: if false;
    }

    // ---------------------------------------------------------------------------------------------
    // /matches/{code}: one VS arena. The 6-character code is the secret needed to join.
    // ---------------------------------------------------------------------------------------------
    match /matches/{code} {

      // Anyone signed in (guests too) can read ONE match if they know its code. That is how Join works.
      allow get: if signedIn();

      // Listing is the class lobby. Accounts only, never guests, and only open listed lobbies of the
      // caller's own class. A guest cannot enumerate matches.
      // The cleanup sweep lists every match of the caller's own class (any status); the class lobby query
      // (listed, lobby, own class) is a narrower case of the same rule. Guests still list nothing.
      allow list: if isAccount()
        && resource.data.cls == get(playerDoc(request.auth.uid)).data.cls;

      // Create: the host only, a real account (never a guest), with exactly this field set and
      // safe starting values. cap is 2..20. cls and hostNick must match the host's own /players doc.
      // The host's own seat (matches/{code}/players/{uid}) is created in the same batch.
      allow create: if isAccount()
        && codeOk(code)
        && request.resource.data.keys().hasOnly(['hostUid', 'hostNick', 'cls', 'deck', 'room', 'seed', 'cap', 'allowGuests',
             'listed', 'status', 'createdAt', 'expireAt', 'playerCount', 'startAt', 'alive', 'aggUid', 'aggUntil',
             'winnerUid', 'endedAt', 'rematch', 'qn'])
        && request.resource.data.keys().hasAll(['hostUid', 'hostNick', 'cls', 'deck', 'room', 'seed', 'cap', 'allowGuests',
             'listed', 'status', 'createdAt', 'expireAt', 'playerCount', 'startAt', 'alive', 'aggUid', 'aggUntil',
             'winnerUid', 'endedAt', 'rematch'])
        && request.resource.data.hostUid == request.auth.uid
        && request.resource.data.cls == get(playerDoc(request.auth.uid)).data.cls
        && request.resource.data.hostNick == get(playerDoc(request.auth.uid)).data.nick
        && request.resource.data.deck in ['s20', 'r4', 'r5', 'r6', 'r7', 'e118', 'cat', 'an', 'iso', 'all']
        && request.resource.data.room in ['ability', 'symbol', 'number', 'shells', 'config', 'table', 'type', 'lab', 'ion', 'metal', 'mixed']
        && request.resource.data.seed is int && request.resource.data.seed >= 0 && request.resource.data.seed < 4294967296
        && request.resource.data.cap is int && request.resource.data.cap >= 2 && request.resource.data.cap <= 20
        && qn(request.resource.data) in [10, 15, 20]
        && request.resource.data.allowGuests is bool
        && request.resource.data.listed is bool
        && request.resource.data.status == 'lobby'
        && request.resource.data.createdAt == request.time
        && request.resource.data.expireAt is timestamp
        // Host alone: a 60-minute cleanup hold (no countdown). The 10-minute start timer is set when a second player joins.
        && request.resource.data.expireAt <= request.time + duration.value(61, 'm')
        && request.resource.data.playerCount == 1
        && request.resource.data.startAt == null
        && request.resource.data.alive == 1
        && request.resource.data.aggUid == request.auth.uid
        && request.resource.data.aggUntil is timestamp
        && request.resource.data.winnerUid == null
        && request.resource.data.endedAt == null
        && request.resource.data.rematch == null;

      // Update. Several narrow cases, any one of which may allow the write. Status only moves forward:
      // lobby -> playing | expired, playing -> done | abandoned. Nothing ever moves back.
      allow update:
        // 1. Expiry: any signed-in user may retire a lobby once its time is up (nothing else may change).
        if (signedIn()
            && resource.data.status == 'lobby'
            && request.time > resource.data.expireAt
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
            && request.resource.data.status == 'expired')

        // 2. Host edits lobby settings. Cap stays 2..20 and cannot drop below the people already seated.
        || (request.auth != null
            && request.auth.uid == resource.data.hostUid
            && resource.data.status == 'lobby'
            && request.resource.data.status == 'lobby'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['deck', 'room', 'seed', 'qn', 'cap', 'allowGuests', 'listed'])
            && request.resource.data.deck in ['s20', 'r4', 'r5', 'r6', 'r7', 'e118', 'cat', 'an', 'iso', 'all']
            && request.resource.data.room in ['ability', 'symbol', 'number', 'shells', 'config', 'table', 'type', 'lab', 'ion', 'metal', 'mixed']
            && request.resource.data.seed is int && request.resource.data.seed >= 0 && request.resource.data.seed < 4294967296
            && request.resource.data.cap is int && request.resource.data.cap >= 2 && request.resource.data.cap <= 20
            && request.resource.data.cap >= resource.data.playerCount
            && qn(request.resource.data) in [10, 15, 20]
            && request.resource.data.allowGuests is bool
            && request.resource.data.listed is bool)

        // 3. Host starts the match (lobby -> playing) and stamps the shared clock with server time.
        || (request.auth != null
            && request.auth.uid == resource.data.hostUid
            && resource.data.status == 'lobby'
            && request.resource.data.status == 'playing'
            && resource.data.playerCount >= 2
            && request.time < resource.data.expireAt
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'startAt', 'aggUid', 'aggUntil', 'alive'])
            && request.resource.data.startAt == request.time)

        // 4. Host announces the rematch code on a finished match (once).
        || (request.auth != null
            && request.auth.uid == resource.data.hostUid
            && resource.data.status == 'done'
            && resource.data.rematch == null
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['rematch'])
            && request.resource.data.rematch is string
            && codeOk(request.resource.data.rematch))

        // 5. Seated players, while playing: end the match (done | abandoned), record the winner, publish
        //    the alive count, and claim or renew the aggregator role (only for yourself, only for accounts).
        || (isParticipant(code)
            && resource.data.status == 'playing'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'winnerUid', 'endedAt', 'alive', 'aggUid', 'aggUntil'])
            && (request.resource.data.status == 'playing'
                || request.resource.data.status == 'abandoned'
                || (request.resource.data.status == 'done' && resource.data.winnerUid == null))
            // Before the last question is over, only an account (the aggregator, on a forfeit or when
            // everyone left) may end the match. A guest cannot cut a match short.
            && (request.resource.data.status == 'playing' || isAccount() || clockOver(resource.data))
            && (request.resource.data.status != 'done' || 'winnerUid' in request.resource.data.diff(resource.data).affectedKeys())
            && (!('winnerUid' in request.resource.data.diff(resource.data).affectedKeys())
                || (request.resource.data.status == 'done'
                    && request.resource.data.winnerUid is string
                    && exists(seatPath(code, request.resource.data.winnerUid))))
            // Ending the match must stamp endedAt with server time, and only ending may.
            && (request.resource.data.status == 'playing'
                ? !('endedAt' in request.resource.data.diff(resource.data).affectedKeys())
                : request.resource.data.endedAt == request.time)
            && (!('alive' in request.resource.data.diff(resource.data).affectedKeys())
                || (isAccount() && request.resource.data.alive is int && request.resource.data.alive >= 0 && request.resource.data.alive <= 20))
            && (!('aggUid' in request.resource.data.diff(resource.data).affectedKeys())
                || (isAccount() && request.resource.data.aggUid == request.auth.uid && resource.data.aggUntil < request.time))
            && (!('aggUntil' in request.resource.data.diff(resource.data).affectedKeys())
                || (isAccount() && request.resource.data.aggUid == request.auth.uid
                    && request.resource.data.aggUntil is timestamp
                    && request.resource.data.aggUntil <= request.time + duration.value(2, 'm'))))

        // 6. Seat count: +1 when your own new seat is created, -1 when your own seat is deleted, lobby only,
        //    never above cap. The seat write happens in the same transaction. The same write may move expireAt:
        //    to about now + 10 min when the count becomes 2 (the start timer begins), or back to the solo hold
        //    (<= now + 60 min) when it drops to 1. 1 minute of slack each way for phone clocks.
        || (signedIn()
            && resource.data.status == 'lobby'
            && request.resource.data.status == 'lobby'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['playerCount', 'expireAt'])
            && request.resource.data.playerCount is int
            && (!('expireAt' in request.resource.data.diff(resource.data).affectedKeys())
                || (request.resource.data.playerCount == 2
                    && request.resource.data.expireAt >= request.time + duration.value(9, 'm')
                    && request.resource.data.expireAt <= request.time + duration.value(11, 'm'))
                || (request.resource.data.playerCount == 1
                    && request.resource.data.expireAt <= request.time + duration.value(61, 'm')))
            && ((request.resource.data.playerCount == resource.data.playerCount + 1
                 && request.resource.data.playerCount <= resource.data.cap
                 && !exists(seatPath(code, request.auth.uid))
                 && existsAfter(seatPath(code, request.auth.uid)))
                || (request.resource.data.playerCount == resource.data.playerCount - 1
                    && request.resource.data.playerCount >= 0
                    && exists(seatPath(code, request.auth.uid))
                    && !existsAfter(seatPath(code, request.auth.uid)))))

        // 7. Cleanup: any account may end a match stuck in 'playing' an hour after it started (everyone left;
        //    the longest match is about 6 minutes). Only status -> abandoned and endedAt (server time) change.
        || (isAccount()
            && resource.data.status == 'playing'
            && request.time > resource.data.startAt + duration.value(1, 'h')
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'endedAt'])
            && request.resource.data.status == 'abandoned'
            && request.resource.data.endedAt == request.time);

      // Cleanup: a dead match (ended, created over a day ago) may be deleted by any account.
      allow delete: if isAccount() && deadMatch(resource.data);

      // -------------------------------------------------------------------------------------------
      // matches/{code}/players/{uid}: a seat. Holds the public scoreboard row for one player.
      // -------------------------------------------------------------------------------------------
      match /players/{uid} {
        // Only people seated in this match can read the board. A seat holder may also read their own
        // (missing) seat, which is how a join transaction checks "already here".
        allow read: if signedIn() && (request.auth.uid == uid || isParticipant(code));
        // Cleanup: the sweep lists a dead match's seats to find what to delete.
        allow list: if isAccount() && deadOrGone(code);

        // Join (or host's first seat). Only for yourself, only with this exact field set and starting values.
        // icon is optional (older clients leave it out) and must be one of the preset ids.
        // Guests: guest == true is forced by provider, and they need allowGuests on the match.
        // Accounts: nick must be the nickname in their own /players doc. Guests: a generated name only.
        allow create: if signedIn()
          && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['nick', 'guest', 'joinedAt', 'lastSeen', 'score', 'correct', 'totalMs',
               'answeredQ', 'reaction', 'reactionAt', 'abandoned', 'left', 'streak', 'icon'])
          && seatIconOk(request.resource.data, uid)
          && request.resource.data.keys().hasAll(['nick', 'guest', 'joinedAt', 'lastSeen', 'score', 'correct', 'totalMs',
               'answeredQ', 'reaction', 'reactionAt', 'abandoned', 'left', 'streak'])
          && request.resource.data.guest == isAnon()
          && request.resource.data.joinedAt == request.time
          && request.resource.data.score == 0
          && request.resource.data.correct == 0
          && request.resource.data.totalMs == 0
          && request.resource.data.answeredQ == -1
          && request.resource.data.abandoned == false
          && request.resource.data.left == false
          && request.resource.data.streak == 0
          && request.resource.data.reaction == null
          && request.resource.data.reactionAt == null
          && (isAnon()
                ? (request.resource.data.nick is string && request.resource.data.nick.matches('^[A-Z][a-z]{2,11} [A-Z][a-z]{2,11}$'))
                : request.resource.data.nick == get(playerDoc(request.auth.uid)).data.nick)
          && (
               // Host creating the match and their own seat in one batch.
               (!exists(matchPath(code))
                && getAfter(matchPath(code)).data.hostUid == request.auth.uid
                && getAfter(matchPath(code)).data.playerCount == 1)
               ||
               // Everyone else: open lobby, a free seat, not expired, guests only if allowed.
               (exists(matchPath(code))
                && get(matchPath(code)).data.status == 'lobby'
                && get(matchPath(code)).data.playerCount < get(matchPath(code)).data.cap
                && request.time < get(matchPath(code)).data.expireAt
                && (!isAnon() || get(matchPath(code)).data.allowGuests == true)
                && getAfter(matchPath(code)).data.playerCount == get(matchPath(code)).data.playerCount + 1)
             );

        // Update.
        allow update: if
          // Your own row: anything except identity fields. answeredQ only goes up. Score only grows, by at
          // most one answer's worth per write, and stays within the maximum for the match's qn questions.
          // Only you can change your own icon, and only to a preset id.
          (signedIn()
            && request.auth.uid == uid
            && request.resource.data.keys().hasOnly(['nick', 'guest', 'joinedAt', 'lastSeen', 'score', 'correct', 'totalMs',
                 'answeredQ', 'reaction', 'reactionAt', 'abandoned', 'left', 'streak', 'icon'])
            && seatIconOk(request.resource.data, uid)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastSeen', 'score', 'correct', 'totalMs',
                 'answeredQ', 'reaction', 'reactionAt', 'abandoned', 'left', 'streak', 'icon'])
            && request.resource.data.answeredQ >= resource.data.answeredQ
            && request.resource.data.answeredQ <= qn(get(matchPath(code)).data) - 1
            // Once marked abandoned, you stay abandoned (no rejoining that match).
            && !(resource.data.abandoned == true && request.resource.data.abandoned != true)
            // Score, correct, totalMs and answeredQ move only together with a brand-new answer doc written in the
            // same batch, and by exactly that answer's values. No answer, no points.
            && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['score', 'correct', 'totalMs', 'answeredQ'])
                || (request.resource.data.answeredQ > resource.data.answeredQ
                    && !exists(answerPath(code, uid, request.resource.data.answeredQ))
                    && existsAfter(answerPath(code, uid, request.resource.data.answeredQ))
                    && request.resource.data.score == resource.data.score + getAfter(answerPath(code, uid, request.resource.data.answeredQ)).data.points
                    && request.resource.data.correct == resource.data.correct + (getAfter(answerPath(code, uid, request.resource.data.answeredQ)).data.correct ? 1 : 0)
                    && request.resource.data.totalMs == resource.data.totalMs + getAfter(answerPath(code, uid, request.resource.data.answeredQ)).data.elapsedMs))
            && request.resource.data.score >= resource.data.score
            && request.resource.data.score - resource.data.score <= 150
            && request.resource.data.score <= 150 * qn(get(matchPath(code)).data)
            && request.resource.data.correct >= resource.data.correct
            && request.resource.data.correct <= qn(get(matchPath(code)).data)
            && request.resource.data.totalMs >= resource.data.totalMs
            && request.resource.data.streak >= 0 && request.resource.data.streak <= qn(get(matchPath(code)).data)
            && (request.resource.data.reaction == null
                || request.resource.data.reaction in ['nice', 'hmm', 'fire', 'gg', 'oops'])
            // 'done' still takes a slow phone's last answer: the answer doc's time window below is what limits it.
            && (get(matchPath(code)).data.status in ['lobby', 'playing', 'done']
                || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastSeen', 'reaction', 'reactionAt', 'left'])))
          ||
          // Someone else's row: the aggregator may only mark a stale player abandoned, while the match is playing.
          // (Deliberate exception to "only your own doc".)
          (isParticipant(code)
            && isAccount()
            && request.auth.uid != uid
            && get(matchPath(code)).data.status == 'playing'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['abandoned'])
            && request.resource.data.abandoned == true);

        // Leaving the lobby deletes your own seat (the seat count drops in the same transaction).
        // Once the match starts, seats stay for the record and you set left = true instead.
        // Cleanup: any account may delete seats of a dead (or already deleted) match.
        allow delete: if (signedIn()
          && request.auth.uid == uid
          && get(matchPath(code)).data.status == 'lobby')
          || (isAccount() && deadOrGone(code));
      }

      // -------------------------------------------------------------------------------------------
      // matches/{code}/answers/{uid}_{q}: one answer per player per question. Never updated or deleted,
      // and only the owner can read it, so nobody sees anyone else's choice.
      // -------------------------------------------------------------------------------------------
      match /answers/{aid} {
        allow read: if signedIn() && aid.split('_')[0] == request.auth.uid;

        // 'done' only for the last question: after a clock finish it is the one answer that can still be in flight
        // (earlier questions' late windows close before the match ends). Nothing after an early forfeit.
        allow create: if isParticipant(code)
          && (get(matchPath(code)).data.status == 'playing'
              || (get(matchPath(code)).data.status == 'done' && request.resource.data.q == qn(get(matchPath(code)).data) - 1))
          && request.resource.data.keys().hasOnly(['q', 'choice', 'elapsedMs', 'correct', 'points', 'at'])
          && request.resource.data.keys().hasAll(['q', 'choice', 'elapsedMs', 'correct', 'points', 'at'])
          && request.resource.data.q is int && request.resource.data.q >= 0 && request.resource.data.q <= qn(get(matchPath(code)).data) - 1
          && aid == request.auth.uid + '_' + string(request.resource.data.q)
          && request.resource.data.choice is int && request.resource.data.choice >= 0 && request.resource.data.choice <= 3
          && request.resource.data.elapsedMs is number && request.resource.data.elapsedMs >= 0
          && request.resource.data.correct is bool
          && request.resource.data.points is int && request.resource.data.points >= 0 && request.resource.data.points <= 150
          && (request.resource.data.correct || request.resource.data.points == 0)
          && getAfter(seatPath(code, request.auth.uid)).data.answeredQ == request.resource.data.q
          && get(seatPath(code, request.auth.uid)).data.abandoned != true
          && request.resource.data.elapsedMs <= 15000
          // Arrival window: from 2 s before the question opens (clock drift) to 8 s after it closes (vs.js LATE_BASE).
          // The client only lets you answer while the question is on screen; the 8 s is for a slow connection
          // delivering that answer late, which also covers the last question after the match flips to done.
          && request.time >= qOpensAt(get(matchPath(code)).data, request.resource.data.q) - duration.value(2000, 'ms')
          && request.time <= qOpensAt(get(matchPath(code)).data, request.resource.data.q) + duration.value(23000, 'ms');

        allow update: if false;
        allow delete: if isAccount() && deadOrGone(code);   // cleanup only
      }

      // -------------------------------------------------------------------------------------------
      // matches/{code}/presence/{uid}: a heartbeat. Written by its owner, read by seated players
      // (in practice only the one aggregator listens).
      // -------------------------------------------------------------------------------------------
      match /presence/{uid} {
        allow read: if isParticipant(code);
        allow create, update: if signedIn()
          && request.auth.uid == uid
          && isParticipant(code)
          && request.resource.data.keys().hasOnly(['at']);
        allow delete: if isAccount() && deadOrGone(code);   // cleanup only
      }
    }
  }
}
